# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Chave pública (anon/publishable). O dashboard novo da Supabase chama-lhe
# "publishable key" — qualquer um dos dois nomes funciona:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Apenas no servidor. Nunca usar o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Segredo longo e aleatorio usado pelo publicador ANCAF.
# Exemplo para gerar: openssl rand -hex 32
ANCAF_SYNC_TOKEN=replace-with-a-long-random-secret

# Segredo exclusivo para POST /api/fcms/sync. Nunca reutilizar a service role.
FCMS_SYNC_TOKEN=replace-with-a-different-long-random-secret

# Credenciais separadas e obrigatórias. Nunca reutilize a chave service_role,
# ANCAF_SYNC_TOKEN ou a mesma palavra-passe entre os dois perfis.
ADMIN_WRITE_PASSCODE=replace-with-a-long-random-admin-passcode
CLUB_DIRECTION_PASSCODE=replace-with-a-different-long-random-passcode
# Opcional, mas recomendado: invalida sessões sem trocar as palavras-passe.
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
# As contas individuais são criadas no Supabase Authentication. Cada utilizador
# autorizado precisa de um registo com o mesmo id em public.ancaf_profiles e
# role='admin'. Depois da migração, renove ADMIN_SESSION_SECRET para invalidar
# definitivamente as sessões antigas baseadas num código partilhado.

# Automação editorial de notícias. A chave ativa a reescrita factual por IA;
# sem ela, as notícias recolhidas ficam obrigatoriamente "A validar".
OPENAI_API_KEY=
NEWS_AI_MODEL=gpt-5-mini
# Defina false para obrigar revisão humana antes de qualquer publicação.
NEWS_AUTO_PUBLISH=true
# Segredo usado pela rotina diária da Vercel.
CRON_SECRET=replace-with-a-long-random-secret
# Opcional: substituir o feed predefinido (ANGOP, Jornal de Angola e RNA).
# NEWS_FEED_URL=https://example.com/feed.xml

# Notificação automática da equipa editorial após alterações em jogos.
# A automação aguarda 15 segundos, cria uma notícia "A validar" e envia este aviso.
RESEND_API_KEY=
NEWS_NOTIFICATION_FROM=notificacoes@ancaf.co.ao
EDITORIAL_NOTIFICATION_EMAILS=kamukotelo@ancaf.co.ao,emanuel.valodia@ancaf.co.ao,rivaldo.domingues@ancaf.co.ao,derby.candido@ancaf.co.ao
NEXT_PUBLIC_SITE_URL=https://ligaunitelgirabola.com
